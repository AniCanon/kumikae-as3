
config_version=5

[application]

config/name="Lantern Reach"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "C#")

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/stretch/mode="canvas_items"

[input]

move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"keycode":4194319), Object(InputEventJoypadMotion,"axis":0,"axis_value":-1.0)]
}

move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"keycode":4194321), Object(InputEventJoypadMotion,"axis":0,"axis_value":1.0)]
}

move_up={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"keycode":4194320), Object(InputEventJoypadMotion,"axis":1,"axis_value":-1.0)]
}

move_down={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"keycode":4194322), Object(InputEventJoypadMotion,"axis":1,"axis_value":1.0)]
}

restart={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":82), Object(InputEventJoypadButton,"button_index":3)]
}

aim_left={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"axis":2,"axis_value":-1.0)]
}

aim_right={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"axis":2,"axis_value":1.0)]
}

aim_up={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"axis":3,"axis_value":-1.0)]
}

aim_down={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"axis":3,"axis_value":1.0)]
}

swing={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":1), Object(InputEventJoypadButton,"button_index":10)]
}

dash={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":32), Object(InputEventJoypadButton,"button_index":1)]
}

place={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":69), Object(InputEventJoypadButton,"button_index":0)]
}

pause={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":4194305), Object(InputEventJoypadButton,"button_index":6)]
}

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true

[dotnet]

project/assembly_name="LanternReach"
