<idea-plugin require-restart="true">
    <id>app.anicanon.kumikae.as3</id>
    <name>Kumikae AS3</name>
    <resource-bundle>messages.KumikaeBundle</resource-bundle>
    <vendor>AniCanon</vendor>
    <description>Build Godot games in ActionScript 3. Edit game settings and scenes, run individual tests, and launch Godot export presets in a browser, on iOS simulators and on Android devices.</description>
    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.plugins.textmate</depends>
    <depends optional="true" config-file="as3-rider.xml">com.intellij.modules.rider</depends>
    <depends optional="true" config-file="as3-idea.xml">com.intellij.modules.idea</depends>
    <extensionPoints>
        <extensionPoint name="gameTarget" beanClass="app.anicanon.kumikae.as3.project.GameTargetContribution" dynamic="true"/>
        <extensionPoint name="deviceGroup" beanClass="app.anicanon.kumikae.as3.panel.DeviceCatalogContribution" dynamic="true"/>
    </extensionPoints>
    <extensions defaultExtensionNs="com.intellij">
        <codeInsight.lineMarkerProvider language="KumikaeAS3" implementationClass="app.anicanon.kumikae.as3.scene.AttachedScenesLineMarker"/>
        <configurationType implementation="app.anicanon.kumikae.as3.run.KumikaeRunType"/>
        <executionTargetProvider implementation="app.anicanon.kumikae.as3.run.AndroidDestinations"/>
        <executionTargetProvider implementation="app.anicanon.kumikae.as3.run.SimulatorDestinations"/>
        <executionTargetProvider implementation="app.anicanon.kumikae.as3.run.IosExecutionTargetProvider"/>
        <runConfigurationProducer implementation="app.anicanon.kumikae.as3.testing.As3TestProducer"/>
        <runLineMarkerContributor language="KumikaeAS3" implementationClass="app.anicanon.kumikae.as3.testing.As3TestLineMarker"/>
        <fileEditorProvider implementation="app.anicanon.kumikae.as3.scene.GdScriptEditorProvider"/>
        <fileEditorProvider implementation="app.anicanon.kumikae.as3.scene.SceneEditorProvider"/>
        <configurationType implementation="app.anicanon.kumikae.as3.testing.As3TestsType"/>
        <fileEditorProvider implementation="app.anicanon.kumikae.as3.settings.ProjectSettingsEditorProvider"/>
        <textmate.bundleProvider implementation="app.anicanon.kumikae.as3.language.As3Grammar"/>
        <notificationGroup id="Kumikae AS3" displayType="BALLOON"/>
        <configurationType implementation="app.anicanon.kumikae.as3.run.SimulatorConfigurationType"/>
        <configurationType implementation="app.anicanon.kumikae.as3.run.GodotConfigurationType"/>
        <postStartupActivity implementation="app.anicanon.kumikae.as3.run.GodotProjectStartup"/>
        <projectViewNestingRulesProvider implementation="app.anicanon.kumikae.as3.project.UidNesting"/>
        <fileType name="ActionScript 3" implementationClass="app.anicanon.kumikae.as3.language.As3FileType"
                  fieldName="INSTANCE" language="KumikaeAS3" extensions="as"/>
        <lang.parserDefinition language="KumikaeAS3"
                               implementationClass="app.anicanon.kumikae.as3.language.As3ParserDefinition"/>
        <lang.commenter language="KumikaeAS3" implementationClass="app.anicanon.kumikae.as3.language.As3Commenter"/>
        <enterHandlerDelegate implementation="app.anicanon.kumikae.as3.language.As3EnterHandler"/>
        <lineIndentProvider implementation="app.anicanon.kumikae.as3.language.As3LineIndentProvider" order="first"/>
        <lang.quoteHandler language="KumikaeAS3" implementationClass="app.anicanon.kumikae.as3.language.As3QuoteHandler"/>
        <lang.braceMatcher language="KumikaeAS3"
                           implementationClass="app.anicanon.kumikae.as3.language.As3BraceMatcher"/>
        <!-- Colours still come from the grammar: the file type is ours, the highlighter is TextMate's. -->
        <editorHighlighterProvider filetype="ActionScript 3"
                                   implementationClass="app.anicanon.kumikae.as3.language.As3EditorHighlighterProvider"/>
        <lang.syntaxHighlighterFactory language="KumikaeAS3"
                                       implementationClass="org.jetbrains.plugins.textmate.language.syntax.highlighting.TextMateSyntaxHighlighterFactory"/>
        <treeStructureProvider implementation="app.anicanon.kumikae.as3.project.GameProjectView"/>
        <directoryIndexExcludePolicy implementation="app.anicanon.kumikae.as3.project.BuildFoldersExcluded"/>
        <projectViewPane implementation="app.anicanon.kumikae.as3.project.GamePane"/>
        <internalFileTemplate name="AS3 File"/>
        <internalFileTemplate name="AS3 Class"/>
        <internalFileTemplate name="AS3 Interface"/>
        <internalFileTemplate name="AS3 Node Script"/>
        <internalFileTemplate name="AS3 Test Case"/>
        <internalFileTemplate name="AS3 Test Suite"/>
        <newProjectWizard.generator implementation="app.anicanon.kumikae.as3.project.As3ProjectWizard"/>
        <toolWindow id="Game Devices" anchor="right" icon="/META-INF/brandMark.svg"
                    factoryClass="app.anicanon.kumikae.as3.panel.SimulatorToolWindowFactory"/>
    </extensions>
    <projectListeners>
        <listener class="app.anicanon.kumikae.as3.project.NewGameTargetListener" topic="com.intellij.execution.RunManagerListener"/>
        <listener class="app.anicanon.kumikae.as3.language.As3LspDependencyListener"
                  topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
    </projectListeners>
    <actions>
        <action id="KumikaeAS3.RunGameTests" class="app.anicanon.kumikae.as3.testing.RunGameTestsAction" text="Run Game Tests">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
        <action id="KumikaeAs3.AddTarget" class="app.anicanon.kumikae.as3.project.AddGameTargetAction" text="Add Game Target…" icon="AllIcons.General.Add">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="first"/>
            <add-to-group group-id="RunMenu" anchor="last"/>
        </action>
        <action id="KumikaeAs3.FindAttachedScenes" class="app.anicanon.kumikae.as3.scene.FindAttachedScenesAction" text="Find Attached Scene Nodes">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
        <action id="KumikaeAs3.ShowMembers" class="app.anicanon.kumikae.as3.project.ShowMembersAction" text="Show AS3 Members">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
        <action id="KumikaeAs3.CompactPackages" class="app.anicanon.kumikae.as3.project.CompactPackagesAction" text="Compact AS3 Packages">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
        <action id="KumikaeAs3.ShowGenerated" class="app.anicanon.kumikae.as3.project.ShowGeneratedAction" text="Show Generated Files">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
        <action id="KumikaeAs3.NewPackage" class="app.anicanon.kumikae.as3.project.NewPackageAction" text="ActionScript Package" icon="AllIcons.Nodes.Package">
            <add-to-group group-id="NewGroup" anchor="first"/>
        </action>
        <action id="KumikaeAs3.NewClass" class="app.anicanon.kumikae.as3.project.NewAs3FileAction">
            <add-to-group group-id="NewGroup" anchor="first"/>
        </action>
    </actions>
</idea-plugin>
