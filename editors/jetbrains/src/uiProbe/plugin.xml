<idea-plugin>
    <id>app.anicanon.kumikae.as3.uiprobe</id>
    <name>Kumikae AS3 UI Probe</name>
    <version>0.1.0</version>
    <vendor>AniCanon</vendor>
    <depends>com.intellij.modules.platform</depends>
    <depends>app.anicanon.kumikae.as3</depends>
    <extensions defaultExtensionNs="app.anicanon.kumikae.as3">
        <deviceGroup label="Probe devices" implementation="app.anicanon.kumikae.as3.panel.UiProbeMissingDriver"/>
        <gameTarget label="Probe target" setupAction="UiProbe.TargetSettings"
                    settingsAction="UiProbe.TargetSettings"
                    configuredWhen="app.anicanon.kumikae.as3.panel.UiProbeTargetMarker"/>
    </extensions>
    <actions>
        <action id="UiProbe.TargetSettings" class="app.anicanon.kumikae.as3.panel.UiProbeTargetSettingsAction"/>
    </actions>
    <extensions defaultExtensionNs="com.intellij">
        <appStarter id="kumikae-as3-ui-check" implementation="app.anicanon.kumikae.as3.panel.UiProbeStarter"/>
    </extensions>
</idea-plugin>
